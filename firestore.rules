rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alleen wie de geheime gezinscode kent, kan de gegevens lezen en schrijven.
    // De lijst met gezinnen zelf is niet op te vragen.
    function codeOk(gezin) {
      return gezin.matches('^[a-z0-9]{16,40}$');
    }

    match /gezinnen/{gezin}/voedingen/{id} {
      allow read, delete: if codeOk(gezin);
      allow create: if codeOk(gezin) && geldig(request.resource.data);
      // Aanpassen mag, maar niet de naam van wie het registreerde overschrijven: zo kan een
      // verouderde telefoon een sessie die de ander al opsloeg niet vervangen.
      allow update: if codeOk(gezin) && geldig(request.resource.data)
        && request.resource.data.door == resource.data.door;
    }

    // Gegevens van het kind, gedeeld tussen de telefoons.
    match /gezinnen/{gezin}/status/gezin {
      allow read, delete: if codeOk(gezin);
      allow write: if codeOk(gezin)
        && request.resource.data.keys().hasOnly(['geboortedatum', 'kind', 'door', 'bijgewerkt'])
        && (request.resource.data.get('geboortedatum', null) == null
            || (request.resource.data.geboortedatum is string && request.resource.data.geboortedatum.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.get('kind', '').size() <= 30
        && request.resource.data.get('door', '').size() <= 30;
    }

    // Lopende timers, gedeeld tussen de telefoons.
    match /gezinnen/{gezin}/status/{doc} {
      allow read, delete: if codeOk(gezin);
      allow write: if codeOk(gezin) && doc == 'timer'
        && request.resource.data.keys().hasOnly(['L', 'R', 'begin', 'laatst', 'bDoor', 'gepauzeerd', 'bSessie', 'K', 'KL', 'KR', 'kModus', 'kBegin', 'kDoor', 'kGepauzeerd', 'kSessie', 'door', 'bijgewerkt'])
        // Wie de borst- of kolftimer wijzigt, moet de sessie kennen die nu op de server staat.
        // Een telefoon met een verouderde stand wordt zo geweigerd en krijgt de actuele stand terug.
        && (resource == null || !gewijzigd(['L', 'R', 'begin', 'laatst', 'bDoor', 'gepauzeerd'])
            || request.resource.data.get('bSessie', null) == resource.data.get('begin', null))
        && (resource == null || !gewijzigd(['K', 'KL', 'KR', 'kModus', 'kBegin', 'kDoor', 'kGepauzeerd'])
            || request.resource.data.get('kSessie', null) == resource.data.get('kBegin', null))
        // Nooit links en rechts tegelijk laten lopen.
        && !(request.resource.data.get('L', {'start': null}).start != null && request.resource.data.get('R', {'start': null}).start != null)
        && request.resource.data.get('door', '').size() <= 30
        && timerVeld(request.resource.data, 'L') && timerVeld(request.resource.data, 'R') && timerVeld(request.resource.data, 'K')
        && timerVeld(request.resource.data, 'KL') && timerVeld(request.resource.data, 'KR')
        // Een timer met tijd erop hoort bij een sessie met een begin. Zo kan een telefoon met een
        // verouderde stand een al opgeslagen sessie niet terughalen.
        && (request.resource.data.get('begin', null) != null || (leeg(request.resource.data, 'L') && leeg(request.resource.data, 'R')))
        && (request.resource.data.get('kBegin', null) != null
            || (leeg(request.resource.data, 'K') && leeg(request.resource.data, 'KL') && leeg(request.resource.data, 'KR')));
    }

    // Een timer is een map met acc (seconden) en start (tijdstip of null).
    function timerVeld(d, k) {
      return !(k in d) || (d[k] is map && d[k].acc is number && (d[k].start == null || d[k].start is int));
    }

    function gewijzigd(velden) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(velden);
    }

    function leeg(d, k) {
      return !(k in d) || (d[k].acc == 0 && d[k].start == null);
    }

    function ml(v) {
      return v is int && v >= 0 && v <= 1000;
    }

    function minuten(v) {
      return v is int && v >= 0 && v <= 240;
    }

    function geldig(d) {
      return d.tijd is int && d.door is string && d.door.size() <= 30
        && (voeding(d) || kolven(d) || luier(d) || slaap(d) || meting(d) || hapje(d));
    }

    // Slaap: begint op tijd, eind is leeg zolang de baby slaapt (hoogstens 24 uur).
    function slaap(d) {
      return d.keys().hasOnly(['type', 'tijd', 'eind', 'door'])
        && d.type == 'slaap'
        && (d.eind == null || (d.eind is int && d.eind >= d.tijd && d.eind - d.tijd <= 86400000));
    }

    // Meting: gewicht in gram en/of lengte in mm.
    function meting(d) {
      return d.keys().hasOnly(['type', 'tijd', 'gewicht', 'lengte', 'door'])
        && d.type == 'meting'
        && (d.get('gewicht', null) == null || (d.gewicht is int && d.gewicht >= 0 && d.gewicht <= 30000))
        && (d.get('lengte', null) == null || (d.lengte is int && d.lengte >= 0 && d.lengte <= 1500))
        && (d.get('gewicht', null) != null || d.get('lengte', null) != null);
    }

    // Eerste hapjes: wat er geproefd is en hoe het ging.
    function hapje(d) {
      return d.keys().hasOnly(['type', 'tijd', 'wat', 'reactie', 'door'])
        && d.type == 'hapje'
        && d.wat is string && d.wat.size() >= 1 && d.wat.size() <= 40
        && (d.get('reactie', null) == null || d.reactie in ['goed', 'matig', 'niet', 'allergie']);
    }

    // Een voeding: borst (per kant), moedermelk uit de fles en kunstvoeding.
    function voeding(d) {
      return d.keys().hasOnly(['type', 'tijd', 'borstL', 'borstR', 'kolf', 'kunst', 'eindKant', 'door'])
        && d.get('type', 'voeding') == 'voeding'
        && minuten(d.borstL) && minuten(d.borstR) && ml(d.kolf) && ml(d.kunst)
        && (d.eindKant == null || d.eindKant in ['L', 'R']);
    }

    // Een luier: nat en/of poep (allebei nee = droog), met eventueel een opmerking.
    function luier(d) {
      return d.keys().hasOnly(['type', 'tijd', 'nat', 'poep', 'opmerking', 'door'])
        && d.type == 'luier' && d.nat is bool && d.poep is bool
        && (d.get('opmerking', null) == null || (d.opmerking is string && d.opmerking.size() <= 200));
    }

    // Een kolfsessie: duur en opbrengst per borst.
    function kolven(d) {
      return d.keys().hasOnly(['type', 'tijd', 'kolfL', 'kolfR', 'duur', 'duurL', 'duurR', 'door'])
        && d.type == 'kolven'
        && ml(d.kolfL) && ml(d.kolfR) && minuten(d.duur)
        && (!('duurL' in d) || minuten(d.duurL)) && (!('duurR' in d) || minuten(d.duurR));
    }
  }
}
