rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alleen wie de geheime gezinscode kent, kan de voedingen lezen en schrijven.
    // De lijst met gezinnen zelf is niet op te vragen.
    match /gezinnen/{gezin}/voedingen/{id} {
      allow read, delete: if gezin.matches('^[a-z0-9]{16,40}$');
      allow create, update: if gezin.matches('^[a-z0-9]{16,40}$') && geldig(request.resource.data);
    }

    function geldig(d) {
      return d.keys().hasOnly(['tijd', 'borstL', 'borstR', 'kolf', 'kunst', 'eindKant', 'door'])
        && d.tijd is int
        && d.borstL is int && d.borstL >= 0 && d.borstL <= 180
        && d.borstR is int && d.borstR >= 0 && d.borstR <= 180
        && d.kolf is int && d.kolf >= 0 && d.kolf <= 1000
        && d.kunst is int && d.kunst >= 0 && d.kunst <= 1000
        && (d.eindKant == null || d.eindKant in ['L', 'R'])
        && d.door is string && d.door.size() <= 30;
    }
  }
}
